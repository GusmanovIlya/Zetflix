@model Zetflix.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = T["Register"];
}

<section>
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card border-0 rounded-4">
                <div class="card-body p-4 p-xl-5">
                    <span class="text-primary fw-semibold">Zetflix</span>
                    <h1 class="mt-2 mb-4">@T["CreateAccount"]</h1>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">@T["UserName"]</label>
                            <input asp-for="UserName" class="form-control" placeholder="@T["UserNamePlaceholder"]" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="you@zetflix.app" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">@T["Password"]</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="@T["StrongPasswordPlaceholder"]" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            @T["Register"]
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <span class="text-body-secondary">@T["HaveAccount"]</span>
                        <a asp-controller="Auth" asp-action="Login" class="text-primary text-decoration-none">@T["Login"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
