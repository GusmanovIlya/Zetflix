@model List<Zetflix.ViewModels.GenreIndexItemViewModel>

@{
    ViewData["Title"] = T["Genres"];
}

<section class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold">@T["Catalog"]</span>
            <h1 class="mb-1">@T["Genres"]</h1>
            <p class="text-body-secondary mb-0">@T["GenreCollections"]</p>
        </div>
    </div>
</section>

@if (!Model.Any())
{
    <div class="card border-0 rounded-4">
        <div class="card-body p-4">
            <p class="mb-0">@T["GenresEmpty"]</p>
        </div>
    </div>
}
else
{
    <section>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var genre in Model)
            {
                var totalCount = genre.MovieCount + genre.ShowCount;

                <div class="col">
                    <a asp-controller="Genres" asp-action="Details" asp-route-id="@genre.Id" class="text-decoration-none">
                        <div class="card border-0 rounded-4 h-100 overflow-hidden">
                            <div class="card-body p-4 p-xl-5">
                                <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary mb-3">@T["Genre"]</span>
                                        <h3 class="mb-0 text-white">@genre.Name</h3>
                                    </div>
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                                         style="width: 54px; height: 54px;">
                                        <i class="ph-fill ph-squares-four fs-3"></i>
                                    </div>
                                </div>

                                <p class="text-body-secondary mb-4">
                                    @totalCount @T["MaterialsInCollection"]
                                </p>

                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-secondary-subtle text-secondary">@genre.MovieCount @T["MoviesCount"]</span>
                                    <span class="badge bg-secondary-subtle text-secondary">@genre.ShowCount @T["ShowsCount"]</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}
