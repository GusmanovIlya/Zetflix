@model Zetflix.ViewModels.EpisodeWatchViewModel

@{
    ViewData["Title"] = $"{Model.Show.Title} - {Model.Episode.Title}";
    var posterUrl = string.IsNullOrWhiteSpace(Model.Show.PosterUrl) ? "/assets/images/pages/01.webp" : Model.Show.PosterUrl;
    var videoUrl = Url.Content(Model.Episode.VideoUrl);
    var videoType = Zetflix.Services.PlayableVideoUrl.GetContentType(Model.Episode.VideoUrl);
}

<a asp-controller="Shows" asp-action="Details" asp-route-id="@Model.Show.Id" class="btn btn-outline-light zetflix-player-topbar">
    <i class="ph ph-caret-left me-2"></i>@T["Back"]
</a>

<section class="zetflix-player-shell">
    <video class="zetflix-player" controls autoplay playsinline preload="metadata" poster="@posterUrl" controlsList="nodownload">
        <source src="@videoUrl" type="@videoType" />
    </video>
</section>
