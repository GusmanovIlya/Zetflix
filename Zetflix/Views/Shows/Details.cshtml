@model Zetflix.ViewModels.ShowDetailsViewModel

@{
    ViewData["Title"] = Model.Show.Title;
    var posterUrl = string.IsNullOrWhiteSpace(Model.Show.PosterUrl) ? "/assets/images/pages/01.webp" : Model.Show.PosterUrl;
    var genres = Model.Show.ShowGenres
        .Where(showGenre => showGenre.Genre != null)
        .Select(showGenre => showGenre.Genre!.Name)
        .ToList();
}

<section class="mb-5">
    <div class="card border-0 rounded-4 overflow-hidden">
        <div class="row g-0 align-items-stretch">
            <div class="col-lg-5">
                <div class="h-100" style="min-height: 460px; background: linear-gradient(180deg, rgba(20,20,20,0.10) 0%, rgba(20,20,20,0.55) 100%), url('@posterUrl') center/cover no-repeat;">
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card-body p-4 p-xl-5">
                    <div class="mb-3">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">
                            @Model.Show.ReleaseYear
                        </span>
                        <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill ms-2">
                            @Model.Seasons.Count сез.
                        </span>
                    </div>

                    <h1 class="mb-3">@Model.Show.Title</h1>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @foreach (var genre in genres)
                        {
                            <span class="badge bg-secondary-subtle text-secondary">@genre</span>
                        }
                    </div>

                    <p class="text-body-secondary fs-5 mb-4">
                        @Model.Show.Description
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Shows" asp-action="Index" class="btn btn-outline-light">
                            Назад к списку
                        </a>
                        @if (Model.Seasons.SelectMany(season => season.Episodes).Any())
                        {
                            var firstEpisode = Model.Seasons.SelectMany(season => season.Episodes).OrderBy(episode => episode.Id).First();
                            <a asp-controller="Shows" asp-action="Watch" asp-route-id="@firstEpisode.Id" class="btn btn-primary">
                                Смотреть
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <span class="text-primary fw-semibold">Эпизоды</span>
            <h2 class="mb-0">Сезоны</h2>
        </div>
    </div>

    @if (!Model.Seasons.Any())
    {
        <div class="card border-0 rounded-4">
            <div class="card-body p-4">
                <p class="mb-0">У сериала пока нет сезонов.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var season in Model.Seasons)
            {
                <div class="col-lg-6">
                    <div class="card border-0 rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h4 class="mb-0">Сезон @season.Number</h4>
                                <span class="badge bg-primary-subtle text-primary">@season.Episodes.Count эп.</span>
                            </div>

                            @if (!season.Episodes.Any())
                            {
                                <p class="text-body-secondary mb-0">Эпизоды пока не добавлены.</p>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var episode in season.Episodes)
                                    {
                                        <a asp-controller="Shows" asp-action="Watch" asp-route-id="@episode.Id"
                                           class="list-group-item list-group-item-action bg-transparent px-0 d-flex gap-3">
                                            <span class="badge bg-secondary-subtle text-secondary align-self-start mt-1">
                                                @episode.EpisodeNumber
                                            </span>
                                            <span>
                                                <span class="d-block fw-semibold">@episode.Title</span>
                                                <span class="d-block text-body-secondary">@episode.Description</span>
                                            </span>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
