@model Zetflix.Models.Review

@{
    ViewData["Title"] = T["DeleteReview"];
    var contentTitle = Model.Movie != null
        ? Model.Movie.Title
        : Model.Show != null ? Model.Show.Title : T["ContentNotSpecified"];
}

<section>
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 rounded-4">
                <div class="card-body p-4 p-xl-5">
                    <span class="text-danger fw-semibold">@T["Deletion"]</span>
                    <h1 class="mt-2 mb-4">@T["DeleteReviewQuestion"]</h1>

                    <div class="card bg-body border-0 rounded-4 mb-4">
                        <div class="card-body p-4">
                            <h4 class="mb-2">@contentTitle</h4>
                            <div class="text-warning mb-3">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= Model.Rating ? "ph-fill" : "ph") ph-star"></i>
                                }
                            </div>
                            <p class="text-body-secondary mb-0">@Model.Comment</p>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-danger">@T["Delete"]</button>
                        <a asp-controller="Reviews" asp-action="Index" class="btn btn-outline-light">@T["Cancel"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
