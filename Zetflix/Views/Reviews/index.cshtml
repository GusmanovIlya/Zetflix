@using System.Security.Claims
@model List<Zetflix.Models.Review>

@{
    ViewData["Title"] = T["Reviews"];
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<section class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="text-primary fw-semibold">@T["Community"]</span>
            <h1 class="mb-1">@T["Reviews"]</h1>
            <p class="text-body-secondary mb-0">@T["ReviewsIntro"]</p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Reviews" asp-action="Create" class="btn btn-primary">@T["AddReview"]</a>
        }
        else
        {
            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="/Reviews/Create" class="btn btn-primary">@T["SignInToReview"]</a>
        }
    </div>
</section>

@if (!Model.Any())
{
    <div class="card border-0 rounded-4">
        <div class="card-body p-4">
            <p class="mb-0">@T["ReviewsEmpty"]</p>
        </div>
    </div>
}
else
{
    <section>
        <div class="row g-4 align-items-start">
            <div class="col-xl-8">
                <div class="row row-cols-1 row-cols-lg-2 g-4">
                    @foreach (var review in Model)
                    {
                        var contentTitle = review.Movie != null
                            ? review.Movie.Title
                            : review.Show != null ? review.Show.Title : T["ContentNotSpecified"];
                        var contentType = review.Movie != null ? T["Movie"] : review.Show != null ? T["Show"] : T["Content"];
                        var isOwner = currentUserId == review.UserId.ToString();

                        <div class="col">
                            <div class="card border-0 rounded-4 h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                        <div>
                                            <span class="badge bg-primary-subtle text-primary mb-2">@contentType</span>
                                            <h4 class="mb-1">@contentTitle</h4>
                                            <div class="text-body-secondary">@T["ByUser"] @review.User?.UserName</div>
                                        </div>
                                        <div class="text-warning text-nowrap">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                <i class="@(i <= review.Rating ? "ph-fill" : "ph") ph-star"></i>
                                            }
                                        </div>
                                    </div>

                                    <p class="text-body-secondary mb-4">@review.Comment</p>

                                    @if (isOwner)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-controller="Reviews" asp-action="Edit" asp-route-id="@review.Id" class="btn btn-outline-light btn-sm">
                                                @T["Edit"]
                                            </a>
                                            <a asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.Id" class="btn btn-outline-danger btn-sm">
                                                @T["Delete"]
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <aside class="col-xl-4">
                <div class="card border-0 rounded-4 realtime-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <span class="text-primary fw-semibold">SignalR</span>
                                <h3 class="mb-1">@T["RealtimeReviews"]</h3>
                                <p class="text-body-secondary mb-0">@T["RealtimeReviewsText"]</p>
                            </div>
                            <span id="signalr-status" class="badge bg-warning text-black">@T["Connecting"]</span>
                        </div>
                        <div id="activity-list" class="realtime-feed">
                            <div class="realtime-feed-empty" data-empty="true">
                                @T["WaitingEvents"]
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </section>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const statusBadge = document.getElementById("signalr-status");
        const activityList = document.getElementById("activity-list");

        if (window.signalR && statusBadge && activityList) {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/notifications")
                .withAutomaticReconnect()
                .build();

            function renderActivity(activity) {
                if (activityList.children.length === 1 && activityList.children[0].dataset.empty === "true") {
                    activityList.innerHTML = "";
                }

                const item = document.createElement("div");
                item.className = "realtime-feed-item";
                const time = new Date(activity.time).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
                item.innerHTML = `
                    <div class="d-flex justify-content-between gap-3">
                        <strong>${activity.action}</strong>
                        <span>${time}</span>
                    </div>
                    <p class="mb-0">${activity.user}: ${activity.details}</p>
                `;
                activityList.prepend(item);

                while (activityList.children.length > 6) {
                    activityList.removeChild(activityList.lastElementChild);
                }
            }

            connection.on("ReceiveActivity", renderActivity);
            connection.start()
                .then(() => {
                    statusBadge.className = "badge bg-success";
                    statusBadge.textContent = "Online";
                })
                .catch(() => {
                    statusBadge.className = "badge bg-danger";
                    statusBadge.textContent = "Offline";
                });
        }
    </script>
}
