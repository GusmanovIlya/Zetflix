@{
    ViewData["Title"] = T["Forbidden"];
}

<section class="py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 text-center">
                <div class="card-body p-5">
                    <span class="text-primary fw-semibold">403</span>
                    <h1 class="mt-2 mb-3">@T["Forbidden"]</h1>
                    <p class="text-body-secondary mb-4">
                        @T["ForbiddenText"]
                    </p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@T["HomeButton"]</a>
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light">@T["SignInDifferent"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
